node_modules/
.env
*.pid
*.sock
pending-events.jsonl
inbox/
*.corrupt-*
__pycache__/

# machine-local fingerprint memo sidecar (common.ts writes it, keyed to local file sizes+mtimes)
.fingerprint

# graphify analysis output
graphify-out/
*.log
*.bak
.DS_Store

# local Claude Code project settings (never ship operator-specific config)
.claude/settings.local.json

# session handoff docs — local, ephemeral working notes the /handoff + /continue
# bridge commands write and read across sessions; never commit them (they go stale).
# ANCHORED to the repo root on purpose: unanchored, `handoff.md` matches at any depth
# and silently swallowed docs/handoff.md — the shipped CONVENTION for these files, which
# a deploy takes from `git ls-files` and would therefore never have carried.
/handoff.md
/HANDOFF.md
/handoff/
PLAN.md
DECISIONS.md

# fetched by scripts/webapp-measure/device-font.mjs (the device font, cached; never committed)
scripts/webapp-measure/.fonts/

# Screenshot / measure OUTPUT dirs. Every scripts/webapp-measure/*.mjs writes its PNGs and JSON into
# a directory beside itself; re-running the script regenerates them, so they are never committed —
# they were untracked on purpose, and listing them in `git status` every session taught readers to
# skim the untracked block, which is where a real stray file hides. Ignoring subdirectories only:
# `cmdcenter-mock/` and `fixtures/` hold tracked inputs and must keep showing new files.
scripts/webapp-measure/*shots*/
scripts/webapp-measure/batch5*/
scripts/webapp-measure/cmdcenter-mock/out/
scripts/webapp-measure/feed/
scripts/webapp-measure/feed-work-out/
scripts/webapp-measure/tmp/
scripts/webapp-measure/work/
cardfoot-shots/
